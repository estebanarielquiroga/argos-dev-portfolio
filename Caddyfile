{
    debug
}

:{$PORT} {
    # Carpeta donde están los archivos de la web
    root * .web/_static
    
    # Servir archivos estáticos
    file_server
    
    # Redirigir la lógica al motor de Python
    reverse_proxy /_event/* localhost:8001
    
    # Soporte para Single Page App
    try_files {path} {path}/ /index.html
}
