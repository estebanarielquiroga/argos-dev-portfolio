:{$PORT:8000} {
    root * /app/.web/build/client

    # Backend: Proxy ultra-simple (Caddy maneja WebSockets solo)
    handle /_event* {
        reverse_proxy localhost:8001
    }
    handle /ping* {
        reverse_proxy localhost:8001
    }
    handle /_upload* {
        reverse_proxy localhost:8001
    }
    handle /_state* {
        reverse_proxy localhost:8001
    }

    # Frontend
    handle {
        try_files {path} {path}/ /index.html
        file_server
    }
}
