:{$PORT:8000} {
    root * /app/.web/build/client

    # Soporte para WebSockets de Reflex 0.9.x
    handle /_event* {
        reverse_proxy localhost:8001 {
            header_up Host {host}
            header_up X-Real-IP {remote_host}
        }
    }

    # Resto de endpoints
    handle /ping* {
        reverse_proxy localhost:8001
    }
    handle /_upload* {
        reverse_proxy localhost:8001
    }
    handle /_state* {
        reverse_proxy localhost:8001
    }

    # Frontend (SPA)
    handle {
        try_files {path} {path}/ /index.html
        file_server
    }
}
